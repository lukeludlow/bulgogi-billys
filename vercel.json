{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        { "source": "/admin", "destination": "/spa" },
        { "source": "/admin/:path*", "destination": "/spa" },
        { "source": "/admin-login", "destination": "/spa" },
        { "source": "/auth/callback", "destination": "/spa" }
    ]
}
