{
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "www.bulgogibillys.com" }],
            "destination": "https://bulgogibillys.com/:path*",
            "permanent": true
        }
    ],
    "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
