{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "es2023",
        "lib": ["ES2023"],
        "module": "esnext",
        // vite/client because the db tier compiles app modules that read
        // import.meta.env (src/admin/data/supabase.ts).
        "types": ["node", "vite/client"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* Linting */
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,

        // The db test tier lives outside src/ but imports from it.
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["vite.config.ts", "vitest.config.ts", "supabase/tests"]
}
